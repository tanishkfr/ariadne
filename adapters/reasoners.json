    },
    "claude": {
      "adapter": "adapters/claude-reasoner.md",
      "capabilities": {
        "creative-review": "externally-unverified",
        "design-direction": "externally-unverified",
        "fresh-task-continuity": "externally-unverified",
        "handoff": "externally-unverified",
        "intake": "externally-unverified",
        "research": "externally-unverified",
        "social-strategy": "externally-unverified",
        "visual-qa-planning": "externally-unverified"
