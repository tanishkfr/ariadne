  "schema_version": 1,
  "providers": {
    "codex": {
      "adapter": "adapters/codex.md",
      "capabilities": {
        "creative-review": "verified",
        "design-direction": "verified",
        "fresh-task-continuity": "verified",
        "handoff": "verified",
        "intake": "verified",
        "research": "verified",
